# Copy to .env and fill in. .env is gitignored.

# Option 1: Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# Option 2: a Google Cloud service account (Vertex AI). Use the google-cloud: prefix
# and point to the key file. Keep the key file outside this repository.
# STOCK_AGENT_MODEL=google-cloud:gemini-3.6-flash
# GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/keys/service-account.json
# GOOGLE_CLOUD_LOCATION=global

# Optional: uncomment to use another Gemini model with Option 1.
# STOCK_AGENT_MODEL=google:gemini-3.8-flash
